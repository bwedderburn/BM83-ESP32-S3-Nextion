diff --git a/shared-module/hashlib/Hash.c b/shared-module/hashlib/Hash.c
index 4b46198ac5dac1a7e5ccd605243c33cc25b20b0d..4f7a883a5389d27136e658463c1f9df9cf2de279 100644
--- a/shared-module/hashlib/Hash.c
+++ b/shared-module/hashlib/Hash.c
@@ -8,20 +8,52 @@
 #include "shared-module/hashlib/__init__.h"
 
 #include "psa/crypto.h"
+#include "py/runtime.h"
+
+bool common_hal_hashlib_hash_deinited(hashlib_hash_obj_t *self) {
+    return self->deinited;
+}
+
+void common_hal_hashlib_hash_deinit(hashlib_hash_obj_t *self) {
+    if (!self->deinited) {
+        // Abort releases the original driver context, not only digest's clone.
+        // PSA abort is safe for an active or failed operation and is idempotent.
+        psa_hash_abort(&self->hash_op);
+        self->deinited = true;
+    }
+}
+
+static void check_active(hashlib_hash_obj_t *self) {
+    if (self->deinited) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Hash is deinitialized"));
+    }
+}
 
 void common_hal_hashlib_hash_update(hashlib_hash_obj_t *self, const uint8_t *data, size_t datalen) {
-    psa_hash_update(&self->hash_op, data, datalen);
+    check_active(self);
+    if (psa_hash_update(&self->hash_op, data, datalen) != PSA_SUCCESS) {
+        common_hal_hashlib_hash_deinit(self);
+        mp_raise_RuntimeError(MP_ERROR_TEXT("Hash update failed"));
+    }
 }
 
 void common_hal_hashlib_hash_digest(hashlib_hash_obj_t *self, uint8_t *data, size_t datalen) {
+    check_active(self);
     if (datalen < common_hal_hashlib_hash_get_digest_size(self)) {
-        return;
+        mp_raise_ValueError(MP_ERROR_TEXT("Hash output buffer too small"));
     }
-    // Clone the operation so we can continue to update or get digest again.
+    // Finish only a clone, preserving repeat digest() and update() semantics.
     psa_hash_operation_t clone = PSA_HASH_OPERATION_INIT;
-    psa_hash_clone(&self->hash_op, &clone);
-    size_t hash_len;
-    psa_hash_finish(&clone, data, datalen, &hash_len);
+    size_t hash_len = 0;
+    psa_status_t status = psa_hash_clone(&self->hash_op, &clone);
+    if (status == PSA_SUCCESS) {
+        status = psa_hash_finish(&clone, data, datalen, &hash_len);
+    }
+    // Also release a partially initialized clone after any native error.
+    psa_hash_abort(&clone);
+    if (status != PSA_SUCCESS || hash_len != common_hal_hashlib_hash_get_digest_size(self)) {
+        mp_raise_RuntimeError(MP_ERROR_TEXT("Hash digest failed"));
+    }
 }
 
 size_t common_hal_hashlib_hash_get_digest_size(hashlib_hash_obj_t *self) {
