diff --git a/nimble/host/store/config/src/ble_store_nvs.c b/nimble/host/store/config/src/ble_store_nvs.c
--- a/nimble/host/store/config/src/ble_store_nvs.c
+++ b/nimble/host/store/config/src/ble_store_nvs.c
@@ -826,6 +826,46 @@
 #endif
 
 #if MYNEWT_VAL(BLE_STORE_MAX_CSFCS)
+int
+ble_store_config_persist_csfc_update(const struct ble_store_value_csfc *old,
+                                     const struct ble_store_value_csfc *value)
+{
+    if (ble_addr_cmp(&old->peer_addr, &value->peer_addr) != 0) {
+        return BLE_HS_EREJECT;
+    }
+
+    /* The count-based persistence path cannot update an existing key.
+     * Verify one exact old record before replacing that same blob. */
+    int slot = 0;
+    for (int i = 1; i <= MYNEWT_VAL(BLE_STORE_MAX_CSFCS); i++) {
+        char key[NIMBLE_NVS_STR_NAME_MAX_LEN];
+        union ble_store_value saved;
+        get_nvs_key_string(BLE_STORE_OBJ_TYPE_CSFC, i, key);
+        int rc = get_nvs_db_value(BLE_STORE_OBJ_TYPE_CSFC, key, &saved);
+        if (rc == ESP_ERR_NVS_NOT_FOUND) {
+            continue;
+        }
+        if (rc != ESP_OK) {
+            return BLE_HS_ESTORE_FAIL;
+        }
+        if (!ble_store_config_csfc_same_peer(&old->peer_addr,
+                                              &saved.csfc.peer_addr)) {
+            continue;
+        }
+        if (slot != 0 || ble_addr_cmp(&old->peer_addr, &saved.csfc.peer_addr) != 0 ||
+            memcmp(old->csfc, saved.csfc.csfc, sizeof old->csfc) != 0) {
+            return BLE_HS_ESTORE_FAIL;
+        }
+        slot = i;
+    }
+    if (slot == 0) {
+        return BLE_HS_ESTORE_FAIL;
+    }
+    char key[NIMBLE_NVS_STR_NAME_MAX_LEN];
+    get_nvs_key_string(BLE_STORE_OBJ_TYPE_CSFC, slot, key);
+    return ble_nvs_write_key_value(key, value, sizeof *value);
+}
+
