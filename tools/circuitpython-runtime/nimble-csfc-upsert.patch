+static inline int
+ble_store_config_csfc_same_peer(const ble_addr_t *a, const ble_addr_t *b)
+{
+    /* Peer identity types 2/3 are the persisted aliases of 0/1. */
+    return a->type <= BLE_ADDR_RANDOM_ID && b->type <= BLE_ADDR_RANDOM_ID &&
+           ((a->type ^ b->type) & 1) == 0 &&
+           memcmp(a->val, b->val, sizeof a->val) == 0;
+}
