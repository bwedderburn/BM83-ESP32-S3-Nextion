# Pinned CircuitPython mpy-cross used to build dist/circuitpython (issue #148).
#
# Single source of truth for build_mpy.sh, scripts/fetch_mpy_cross.sh and the
# build-circuitpython-dist workflow. Plain KEY=VALUE lines: sourced by bash and
# parsed by tests/test_mpy_cross_pin.py, so keep it free of shell expansions.
#
# The mpy-cross version must match the CircuitPython runtime on the device.
# Bump this deliberately, together with the device firmware, never to "latest":
#   1. Pick the release key from
#      https://adafruit-circuit-python.s3.amazonaws.com/?prefix=bin/mpy-cross/linux-amd64/
#   2. Download it and record `sha256sum` below.
#   3. Rebuild dist/ and hardware-test the unit on that CircuitPython version.
#
# 10.3.1 matches the unit's runtime as recorded in the 2026-10-03 supervised
# bench run (docs/hardware-test-limitations.md, PR #159).
MPY_CROSS_VERSION=10.3.1
MPY_CROSS_LINUX_AMD64_KEY=bin/mpy-cross/linux-amd64/mpy-cross-linux-amd64-10.3.1.static
MPY_CROSS_LINUX_AMD64_SHA256=aa74dcb51e51c1a70fd268dad9e05b40f72c29df3082f86c3a20665360e4acda
