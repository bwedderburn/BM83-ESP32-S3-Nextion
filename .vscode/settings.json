{
  "files.eol": "\n",
  "files.associations": {
    "*.patch": "diff",
    ".bandit": "ini",
    ".flake8": "ini"
  },
  "files.exclude": {
    ".venv": true,
    "**/.pio": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/pytest-cache-files-*": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.pio/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/pytest-cache-files-*/**": true,
    "build/**": true,
    "dist/**": true,
    "tools/mpy-cross/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.pio": true,
    "build": true,
    "dist": true,
    "tools/mpy-cross": true,
    "docs/reference/vendor": true
  },
  "python.analysis.extraPaths": [
    "firmware/circuitpython",
    "firmware/circuitpython/lib",
    "addons/universe-badge/apps/bm83_remote"
  ],
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/pytest-cache-files-*",
    "**/.*",
    "build",
    "dist",
    "docs/reference/vendor",
    "firmware/crowpanel-remote/.pio"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "ruff.lint.enable": false,
  "flake8.importStrategy": "fromEnvironment",
  "flake8.severity": {
    "E": "Information",
    "W": "Information",
    "C": "Information",
    "F": "Warning",
    "E901": "Error",
    "E902": "Error",
    "E999": "Error",
    "F631": "Error",
    "F632": "Error",
    "F633": "Error",
    "F634": "Error",
    "F701": "Error",
    "F702": "Error",
    "F704": "Error",
    "F706": "Error",
    "F707": "Error",
    "F708": "Error",
    "F709": "Error",
    "F721": "Error",
    "F722": "Error",
    "F821": "Error",
    "F822": "Error",
    "F823": "Error",
    "F824": "Error"
  },
  "[python]": {
    "editor.rulers": [127],
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[diff]": {
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false
  }
}
