{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: dev environment (.venv, stubs, extensions)",
      "detail": "Creates or updates .venv, installs requirements-dev.txt and the repo-health MCP dependency, selects ESP32-S3 board stubs and installs the recommended extensions. Never touches a board.",
      "type": "process",
      "command": "bash",
      "args": ["scripts/setup-dev.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts\\setup-dev.ps1"]
      },
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "BM83: host tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "BM83: test current file",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BM83: lint gate (CI flake8)",
      "detail": "The flake8 selection that fails python-package.yml.",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "flake8", ".", "--count", "--select=E9,F63,F7,F82", "--show-source", "--statistics"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": {
        "owner": "flake8-gate",
        "source": "flake8",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): ([A-Z]\\d+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "BM83: lint advisory (CI flake8 report)",
      "detail": "The advisory pass CI prints but never fails on.",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "flake8", ".", "--count", "--exit-zero", "--max-complexity=10", "--max-line-length=127", "--statistics"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": {
        "owner": "flake8-advisory",
        "source": "flake8",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "severity": "info",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): ([A-Z]\\d+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "BM83: reliability policy",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/check_reliability_setup.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "BM83: frozen toolchain advisory audit",
      "detail": "Host-only, no dependency installation; reports current advisories and preserves failures.",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip_audit", "--disable-pip", "--no-deps", "-r", "tools/circuitpython-runtime/requirements-build.txt"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "BM83: security (host only)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "bandit", "--ini", ".bandit", "-r", "firmware/circuitpython", "addons/universe-badge/apps/bm83_remote", "scripts", "-ll"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Quick checks: BM83 lint and reliability policy",
      "detail": "Fast host checks on Windows and Linux after developer setup. Runs the CI lint gate and reliability policy check.",
      "dependsOrder": "sequence",
      "dependsOn": ["BM83: lint gate (CI flake8)", "BM83: reliability policy"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "CI parity: lint gate, host tests, policy",
      "detail": "Runs lint, the full host test suite and reliability policy in order. Use Linux, WSL or the dev container for the full suite.",
      "dependsOrder": "sequence",
      "dependsOn": ["BM83: lint gate (CI flake8)", "BM83: host tests", "BM83: reliability policy"],
      "problemMatcher": []
    },
    {
      "label": "CrowPanel: build firmware (PlatformIO, no upload)",
      "detail": "Compile-only check of firmware/crowpanel-remote. Flashing follows the CrowPanel README.",
      "type": "process",
      "command": "pio",
      "args": ["run", "-d", "firmware/crowpanel-remote", "-e", "crowpanel_esp32s3_7in"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": {
        "owner": "cpp",
        "source": "platformio",
        "fileLocation": ["autoDetect", "${workspaceFolder}/firmware/crowpanel-remote"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Template: initialize new project (dry run)",
      "detail": "After 'Use this template': preview the identity and agent-note changes. Writes nothing.",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/init_from_template.py", "--name", "${input:projectName}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Template: initialize new project (apply)",
      "detail": "Writes the changes the dry run listed. Commit or stash your own edits first.",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/init_from_template.py", "--name", "${input:projectName}", "--apply"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "projectName",
      "type": "promptString",
      "description": "New project name (for example: Garage BM83 Remote)"
    }
  ]
}
